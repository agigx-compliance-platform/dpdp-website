# Consent Management Service API base URL
NEXT_PUBLIC_CONSENT_API_URL=https://api.agigx.com

# Site URL for Open Graph / social cards (set in production)
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: one line under the hero subtitle if on‑screen video text differs from site copy (e.g. typo in source video).
# Optional: authenticated CMP screenshots (capture script reads .env.local; never commit passwords)
# AGIGX_UI_LOGIN_EMAIL=
# AGIGX_UI_LOGIN_PASSWORD=
