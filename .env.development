# Consent Management Service API base URL for Local Development
NEXT_PUBLIC_CONSENT_API_URL=http://localhost:8084
CONSENT_API_URL=http://localhost:8084

# Local stack (dev-orchestration): the SDK script is served by agigx-sdk on :5001, not by the
# consent API, and seed-users.sh seeds the "localhost" consent domain (cookie banner + contact_us).
NEXT_PUBLIC_SDK_BASE_URL=http://localhost:5001
NEXT_PUBLIC_CONSENT_DOMAIN=localhost
